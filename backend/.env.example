MONGO_URI=mongodb://127.0.0.1:27017/examdb
# The server REFUSES TO START if any of these are missing, short (<32 chars), placeholders, or (for the JWT pair) identical.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# HMAC key for the audit hash chain. Keep it OUT of the database. Changing it invalidates verification of existing v2 entries.
AUDIT_HMAC_KEY=
# 32 random bytes (hex or base64) that wrap every Shamir share stored in MongoDB. Keep it OUT of the database
# (secrets manager / env). LOSING IT MAKES EXISTING PAPERS UNDECRYPTABLE — back it up separately.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_WRAP_KEY=
# MAX_UPLOAD_MB=10   (hard cap 15 — ciphertext is stored inline in one MongoDB document)
# VERIFY_RATE_MAX=10   audit-verify calls per IP per minute
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d
PORT=5000
# Set this to your real origin in production (needed for the httpOnly refresh cookie)
# CORS_ORIGIN=https://exams.iiitkottayam.ac.in
# NODE_ENV=production   (makes the refresh cookie "secure" -> HTTPS only)

# Only these email addresses may sign up (leave the line out to use this default, set empty to allow any)
ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in

# First admin, created by:  npm run seed:admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@iiitkottayam.ac.in
ADMIN_PASSWORD=ChangeThis!Now2026

# Rate limits (defaults shown). Raise SIGNUP_RATE_MAX if you create lots of test accounts.
# SIGNUP_RATE_MAX=10          successful signups per IP per hour
# LOGIN_ACCOUNT_RATE_MAX=10   failed logins per IP+email per 15 min
# LOGIN_IP_RATE_MAX=100       failed logins per IP per 15 min
# API_RATE_MAX=300            all API calls per IP per 15 min

# Set to 1 only when running behind a reverse proxy / load balancer
# TRUST_PROXY=1

# Demonstration tools for viva (audit tampering simulation & snapshot restoration).
# Keep false in normal/production environments. Set to true when presenting or recording demonstration.
ENABLE_AUDIT_DEMO_TOOLS=false
